# ============================================
# NEXT.JS ENVIRONMENT VARIABLES
# Set these in .env.local (or Vercel dashboard)
# ============================================

# Convex
CONVEX_DEPLOYMENT=           # e.g. "dev:your-project-123"
NEXT_PUBLIC_CONVEX_URL=      # e.g. "https://your-project-123.convex.cloud"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=  # pk_test_... or pk_live_...
CLERK_SECRET_KEY=                    # sk_test_... or sk_live_...
CLERK_WEBHOOK_SECRET=                # whsec_... (from Clerk webhook settings)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Resend
RESEND_API_KEY=              # re_... (from resend.com dashboard)

# Internal
INTERNAL_API_SECRET=         # Generate with: openssl rand -hex 32
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # Change to https://waitlist.expert in production

# ============================================
# CONVEX ENVIRONMENT VARIABLES
# Set these via: npx convex env set KEY VALUE
# These run in Convex's runtime, NOT Node.js
# ============================================
# CLERK_JWT_ISSUER_DOMAIN    -> npx convex env set CLERK_JWT_ISSUER_DOMAIN "https://your-clerk-app.clerk.accounts.dev"
# SITE_URL                   -> npx convex env set SITE_URL "https://waitlist.expert"
# INTERNAL_API_SECRET        -> npx convex env set INTERNAL_API_SECRET "same-value-as-above"
